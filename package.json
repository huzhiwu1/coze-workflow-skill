{
  "name": "coze-workflow-skill",
  "version": "1.0.0",
  "description": "Coze 工作流确定性能力（扫码登录 + MCP + CLI），零项目依赖，分享即用",
  "type": "module",
  "scripts": {
    "login": "node scripts/coze-login.mjs",
    "cli": "node scripts/coze-cli.mjs",
    "mcp": "node dist/coze-mcp.cjs",
    "mcp:dev": "tsx src/mcp-entry.ts",
    "build": "esbuild src/mcp-entry.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/coze-mcp.cjs --external:node:*",
    "typecheck": "tsc --noEmit",
    "build:update": "esbuild scripts/coze-update.mjs --bundle --platform=node --format=cjs --target=node18 --outfile=dist/coze-update.cjs --external:node:*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}